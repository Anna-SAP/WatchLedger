{
  "manifest_version": 3,
  "name": "视听档案 WatchLedger",
  "version": "0.1.2",
  "description": "仅在本机记录网页视频与音频播放，汇总到本地视听档案。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/disconnected-16.png",
    "32": "icons/disconnected-32.png",
    "48": "icons/disconnected-48.png",
    "128": "icons/disconnected-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png",
      "48": "icons/disconnected-48.png",
      "128": "icons/disconnected-128.png"
    },
    "default_title": "视听档案 · 未连接"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "watchledger@local.personal",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}